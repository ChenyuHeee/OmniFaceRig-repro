outputs/*
!outputs/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 官方提供的测试资源(23 个 T-pose glb、2D 图、演示 glb/mov、服务器访问 docx)
